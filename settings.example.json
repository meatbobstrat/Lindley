{
  "watch_folders": ["./data/inbox"],
  "processing_dir": "./data/processing",
  "quarantine_dir": "./data/quarantine",
  "library_dir": "./data/library",
  "db_path": "./data/lindley.db",
  "move_files": false,
  "add_mode": "ask",
  "ocr": {
    "engine": "hybrid",
    "tesseract_path": null,
    "languages": ["eng"],
    "confidence_threshold": 70,
    "review_below": 80,
    "vision_max_side": 2000,
    "workers": null
  },
  "assembler": {
    "group_at": 75,
    "hint_at": 45,
    "ai_band": [35, 75]
  },
  "ai": {
    "jobs": {
      "vision": { "connection": "local", "model": null },
      "assemble": { "connection": "claude", "model": null },
      "chat": { "connection": "claude", "model": null },
      "embed": { "connection": "local", "model": null }
    },
    "providers": {
      "local": {
        "type": "local",
        "label": "Ollama on this computer",
        "base_url": "http://localhost:11434/v1",
        "model": "gemma4:e4b",
        "allow": "ask",
        "daily_limit": null,
        "monthly_limit": null,
        "per_minute": null,
        "at_once": 1
      },
      "claude": {
        "type": "anthropic",
        "label": "Claude",
        "model": "claude-opus-5",
        "allow": "ask",
        "daily_limit": 50,
        "monthly_limit": 1000,
        "per_minute": 30,
        "at_once": 2
      },
      "openai": {
        "type": "openai",
        "label": "OpenAI",
        "model": "gpt-6.1-sol",
        "api_key_env": "OPENAI_API_KEY",
        "allow": "ask",
        "daily_limit": 50,
        "monthly_limit": 1000,
        "per_minute": 30,
        "at_once": 2
      },
      "gemini": {
        "type": "google",
        "label": "Gemini",
        "model": "gemini-3.8-flash",
        "allow": "ask",
        "daily_limit": 50,
        "monthly_limit": 1000,
        "per_minute": 30,
        "at_once": 2
      }
    }
  }
}
